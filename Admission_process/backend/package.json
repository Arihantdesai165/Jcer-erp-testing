    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "sequelize": "^6.35.2",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.7.2",
    "stripe": "^13.10.0",
